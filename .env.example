# Public browser settings only. Never put a provider or service secret in a VITE_ name.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only settings: set them in Bolt / Supabase function secrets, never in this file or the browser.
# XAI_API_KEY                 owner-supplied xAI key, read only by the forecast function (live mode)
# FORECAST_MODEL_ID           must equal the enabled model_profiles row's modelId (grok-4.7 is unverified)
# APP_ORIGIN                  optional comma-separated CORS allowlist for the forecast function
# SUPABASE_URL                platform-injected for edge functions
# SUPABASE_ANON_KEY           platform-injected for edge functions
# SUPABASE_SERVICE_ROLE_KEY   platform-injected; used only after JWT and ownership checks
# Live/profile/cap settings live in the database: public.model_profiles and public.app_limits.
# EXA_API_KEY                 optional M5 retrieval only; not implemented in this build
